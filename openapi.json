              },
              "example": {
                "store_id": "netz_kaizen",
                "shop_code": "01",
                "call_datetime": "2024-09-01 08:12:34",
                "call_duration": 126,
                "caller_phone_number": "042-000-0000",
                "receiver_phone_number": "090-0000-0000",
                "call_content": "お世話になっております。加藤です。石山さまのご都合の良い時に、試験にお付き合いいただきたいのですが、いかがでしょうか",
                "call_summary": "■ 発信者：加藤\n■ 受信者：石山\n■ 内容：加藤が石山に試験に付き合ってほしいと連絡し、石山がそれを了承しました。"
              }
            }
          }
        }
