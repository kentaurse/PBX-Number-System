                    "result": {
                      "type": "boolean",
                      "example": false,
                      "description": "結果"
                    },
                    "error": {
                      "type": "string",
                      "example": "システムエラー",
                      "description": "エラーメッセージ"
                    }
                  },
                  "required": [
                    "result",
                    "error"
                  ]
                }
              }
            }
          }
