              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "boolean",
                      "example": false,
                      "description": "結果"
                    },
                    "error": {
                      "type": "string",
                      "example": "店舗コードが正しくありません",
                      "description": "エラーメッセージ"
                    }
                  },
                  "required": [
                    "result",
                    "error"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
