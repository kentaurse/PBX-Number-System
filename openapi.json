          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "boolean",
                      "example": true,
                      "description": "結果"
                    },
                    "message": {
                      "type": "string",
                      "example": "出庫",
                      "description": "メッセージ（※出庫の場合のみ）"
                    },
                    "visit_id": {
                      "type": "string",
                      "example": "1234567890",
                      "description": "来店ID（※入庫の場合のみ）"
                    },
                    "store_id": {
                      "type": "string",
                      "example": "netz_kaizen",
                      "description": "販売店ID"
                    },
                    "shop_id": {
                      "type": "string",
                      "example": "01",
                      "description": "店舗コード（ログインID）"
                    },
                    "license_area": {
                      "type": "string",
                      "example": "品川",
                      "description": "地域名"
                    },
                    "license_type": {
                      "type": "string",
                      "example": "300",
                      "description": "分類番号"
                    },
                    "license_kana": {
                      "type": "string",
                      "example": "ｱ",
                      "description": "ひらがな（半角ｶﾅ）"
                    },
                    "license_no": {
                      "type": "string",
                      "example": "1111",
                      "description": "一連指定番号"
                    },
                    "entrance": {
                      "type": "string",
                      "example": "0",
                      "description": "入口番号"
                    },
                    "customer": {
                      "type": "object",
                      "description": "合致（or登録）した会員（車両）情報"
                    }
                  },
                  "required": [
                    "result",
                    "store_id",
                    "shop_id",
                    "license_area",
                    "license_type",
                    "license_kana",
                    "license_no",
                    "entrance",
                    "customer"
                  ]
