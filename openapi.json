        "summary": "ナンバー送信",
        "operationId": "ナンバー送信",
        "description": "",
        "tags": [
          "カメラ連携"
        ],
        "parameters": [
          {
            "name": "X-API-AUTH",
            "in": "header",
            "description": "認証コード",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "abcdefghijklmnopqrstuvwxyz01234"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "store_id": {
                    "type": "string",
                    "description": "販売店ID"
                  },
                  "shop_id": {
                    "type": "string",
                    "description": "店舗コード（ログインID）"
                  },
                  "type": {
                    "type": "integer",
                    "description": "0:入庫、1:出庫、-1:不明"
                  },
                  "license_area": {
                    "type": "string",
                    "description": "地域名"
                  },
                  "license_type": {
                    "type": "string",
                    "description": "分類番号"
                  },
                  "license_kana": {
                    "type": "string",
                    "description": "ひらがな（全角かな）"
                  },
                  "license_no": {
                    "type": "string",
                    "description": "一連指定番号"
                  },
                  "entrance": {
                    "type": "string",
                    "description": "入口コード"
                  }
                },
                "required": [
                  "store_id",
                  "shop_id",
                  "shop_code",
                  "type",
                  "license_area",
                  "license_type",
                  "license_kana",
                  "license_no",
                  "entrance"
                ]
              },
              "example": {
                "store_id": "netz_kaizen",
                "shop_id": "01",
                "type": 0,
                "license_area": "品川",
                "license_type": "300",
                "license_kana": "あ",
                "license_no": "1111",
                "entrance": "0"
              }
            }
          }
        }
      }
    },
